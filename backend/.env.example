# AcneClear backend environment — copy to .env and fill in real values.
# NEVER commit the filled-in .env file.

# --- Supabase (project settings → API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection string (project settings → Database)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- AI models ---
# Public URL of your trained skin-analysis model endpoint (Colab/ngrok/VM)
SKIN_ANALYSIS_MODEL_URL=
# Public URL of your image-enhancement model endpoint (leave empty to disable)
IMAGE_ENHANCEMENT_MODEL_URL=
# Server-side AI provider key for the chatbot (OpenAI-compatible or other)
AI_PROVIDER_API_KEY=
# AI provider base URL (e.g. https://api.openai.com/v1)
AI_PROVIDER_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_MODEL=gpt-4o-mini

# --- Frontend origin allowed by CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
